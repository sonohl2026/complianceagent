APP_ENV=development
APP_NAME=MedTech Reimbursement Readiness Agent
APP_HOST=127.0.0.1
FRONTEND_PORT=3000
API_PORT=8000

POSTGRES_DB=medtech_agent
POSTGRES_USER=medtech
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://medtech:change-me@postgres:5432/medtech_agent

REDIS_URL=redis://redis:6379/0

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_SYNTHESIS_MODEL=
OPENROUTER_CITATION_MODEL=
OPENROUTER_ZDR=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=MedTech Reimbursement Readiness Agent

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

STORAGE_ROOT=/app/data/storage
MAX_UPLOAD_MB=100
MAX_CRAWL_PAGES=250
MAX_CRAWL_DEPTH=4
CRAWL_DELAY_MS=750
ALLOW_OCR=false
ALLOW_LAN_ACCESS=false

SECRET_KEY=replace-with-random-value
LOG_LEVEL=INFO
STORE_RAW_MODEL_RESPONSES=true
STORE_PROMPT_LOGS=true
